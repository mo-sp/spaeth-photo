{
  // Build scripts and tests do NOT run through Nuxt but directly under Node 24
  // (native type stripping: `node scripts/x.ts`). Node only strips types, it
  // transforms nothing - hence `erasableSyntaxOnly`, which forbids exactly the
  // constructs (enum, parameter properties, value namespaces) that would need a
  // real transformation.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "vitest*.config.ts"]
}
