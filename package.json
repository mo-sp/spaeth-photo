{
  "name": "spaeth-photo",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "predev": "pnpm build-images",
    "dev": "nuxt dev",
    "export-sources": "node scripts/export-sources.ts",
    "build-images": "node scripts/build-images.ts",
    "check-manifest": "node scripts/check-manifest.ts",
    "generate": "nuxt generate",
    "build": "pnpm build-images && pnpm generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretypecheck": "pnpm build-images",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "exif-reader": "^2.0.3",
    "nuxt": "^4.5.2",
    "sharp": "^0.35.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.0"
  }
}
